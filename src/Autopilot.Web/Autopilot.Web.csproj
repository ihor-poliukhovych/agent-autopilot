<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Autopilot.Web</RootNamespace>
    <OutputType>Library</OutputType>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <Description>The local web UI of Autopilot: minimal API plus static pages, bound to 127.0.0.1.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Autopilot.Core\Autopilot.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*" LogicalName="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
