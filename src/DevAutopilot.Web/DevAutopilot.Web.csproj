<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>DevAutopilot.Web</RootNamespace>
    <OutputType>Library</OutputType>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <Description>The local web UI of Dev Autopilot: minimal API plus static pages, bound to 127.0.0.1.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DevAutopilot.Core\DevAutopilot.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*" />
  </ItemGroup>

</Project>
